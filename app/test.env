NODE_OPTIONS="--no-deprecation --no-experimental-strip-types"

# Integration-test environment. `.env` points DATABASE_URI at the Docker service
# host `postgres`, which is unresolvable on a dev host; vitest.setup.ts loads this
# file with override so `npm run test:int` targets a local test database.
# Requires a Postgres reachable at this URI (e.g. a local container) to actually run.
DATABASE_URI=postgres://lesson3:lesson3@localhost:5432/lesson3_test
PAYLOAD_SECRET=test-secret-not-for-production

# ⚑ NO SIGNUP-LIMITER OVERRIDES HERE, AND NONE ARE NEEDED (#324, 2026-09-19). This file used to carry
# RATE_LIMIT_SIGNUP_GLOBAL_MAX=10000 and a 1 ms window, because fixture users created through the
# Local API were counted as anonymous signups and exhausted the shared budget. `authRateLimit` now
# classifies on `overrideAccess`, so trusted creates are not signups and there is nothing to work
# around. Do not reintroduce them — `tests/unit/testSignupLimitConfig.spec.ts` asserts their absence,
# and on any runner that reaches a shared database a short window makes the real limiter fail OPEN.
