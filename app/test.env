NODE_OPTIONS="--no-deprecation --no-experimental-strip-types"

# Integration-test environment. `.env` points DATABASE_URI at the Docker service
# host `postgres`, which is unresolvable on a dev host; vitest.setup.ts loads this
# file with override so `npm run test:int` targets a local test database.
# Requires a Postgres reachable at this URI (e.g. a local container) to actually run.
DATABASE_URI=postgres://lesson3:lesson3@localhost:5432/lesson3_test
PAYLOAD_SECRET=test-secret-not-for-production

# Fixture-heavy suites create real Users through the production hook, and those trusted Local-API
# creates carry no `req.user`, so `authRateLimit` counts each one as an anonymous signup. Give this
# ISOLATED database deterministic headroom and a per-request window.
#
# WHY THIS FILE ONLY, AND IT IS THE WHOLE POINT. `vitest.setup.ts` loads it for `test:int`, whose
# DATABASE_URI is the private `lesson3_test`. Do NOT hand these values to `test:http` or `test:e2e`:
# those runners seed through the Local API against the database the RUNNING app serves from — on the
# Rock, per `vitest.http.config.mts`, the LIVE `lesson3`. `rateLimit.ts`'s upsert rewrites
# `window_start` unconditionally, so a 1 ms window there makes the app's next signup see a differing
# window and RESET the real daily count to 1 — an abuse limiter turned fail-open. A shared counter
# row means test-local env is not test-local. Caught in review before merge (2026-08-30).
RATE_LIMIT_SIGNUP_GLOBAL_MAX=10000
RATE_LIMIT_SIGNUP_GLOBAL_WINDOW_MS=1
