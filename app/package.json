{
  "name": "app",
  "version": "1.0.0",
  "description": "A blank template to get started with Payload 3.0",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "check:approuter": "node scripts/check-approuter.mjs",
    "build": "npm run check:approuter && cross-env NODE_OPTIONS=\"--no-deprecation --max-old-space-size=8000\" next build",
    "dev": "npm run check:approuter && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "devsafe": "npm run check:approuter && rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next dev",
    "generate:importmap": "cross-env NODE_OPTIONS=--no-deprecation payload generate:importmap",
    "generate:types": "cross-env NODE_OPTIONS=--no-deprecation payload generate:types",
    "lint": "cross-env NODE_OPTIONS=--no-deprecation eslint . --max-warnings=0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,scss}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.{ts,mjs}\" \"*.{ts,mts,mjs}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,scss}\" \"tests/**/*.{ts,tsx}\" \"scripts/**/*.{ts,mjs}\" \"*.{ts,mts,mjs}\"",
    "payload": "cross-env NODE_OPTIONS=--no-deprecation payload",
    "typecheck": "rm -rf .next && cross-env NODE_OPTIONS=--no-deprecation next typegen && tsc --noEmit -p tsconfig.json",
    "start": "cross-env NODE_OPTIONS=--no-deprecation next start",
    "audit:prod": "npm audit --omit=dev --audit-level=high",
    "audit:all": "npm audit --audit-level=moderate",
    "test": "npm run test:int && npm run test:e2e",
    "test:rock": "npm run test:unit && npm run test:int && npm run test:http",
    "test:e2e": "cross-env NODE_OPTIONS=\"--no-deprecation --import=tsx/esm\" playwright test --config=playwright.config.ts",
    "test:http": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.http.config.mts",
    "test:int": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.config.mts",
    "test:unit": "cross-env NODE_OPTIONS=--no-deprecation vitest run --config ./vitest.unit.config.mts"
  },
  "dependencies": {
    "@payloadcms/db-postgres": "3.88.0",
    "@payloadcms/email-nodemailer": "3.88.0",
    "@payloadcms/next": "3.88.0",
    "@payloadcms/richtext-lexical": "3.88.0",
    "@payloadcms/ui": "3.88.0",
    "@sentry/node": "10.63.0",
    "acorn": "8.16.0",
    "cross-env": "7.0.3",
    "docx": "9.6.1",
    "dompurify": "3.4.14",
    "dotenv": "16.4.7",
    "drizzle-orm": "0.45.2",
    "graphql": "16.14.2",
    "jsdom": "28.0.0",
    "jszip": "3.10.1",
    "mammoth": "1.12.1",
    "next": "16.3.2",
    "payload": "3.88.0",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "sharp": "0.35.3"
  },
  "overrides": {
    "undici": "7.29.0",
    "postcss": {
      ".": "8.5.23",
      "nanoid": "3.3.18"
    },
    "nodemailer": "9.0.1",
    "js-yaml": "4.3.1",
    "fast-uri": "3.1.5",
    "immutable": "4.3.9",
    "sharp": "0.35.3",
    "docx": {
      "nanoid": "5.1.16"
    }
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "16.3.2",
    "@types/jsdom": "28.0.3",
    "@types/node": "22.19.9",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@vitejs/plugin-react": "4.5.2",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "prettier": "3.8.3",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "4.1.11"
  },
  "engines": {
    "node": ">=24.19.0 <25"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=24.19.0 <25",
      "onFail": "error"
    }
  }
}
