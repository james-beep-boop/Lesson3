{
  "entry": [
    "src/payload.config.ts",
    "src/migrations/index.ts",
    "src/instrumentation.ts",
    "src/app/**/{page,layout,route,error,global-error,not-found,loading,template,default}.{ts,tsx}",
    "src/app/**/{robots,sitemap,manifest,icon,apple-icon,opengraph-image,twitter-image}.{ts,tsx}",
    "scripts/*.{ts,mjs}",
    "tests/**/*.{spec,test}.{ts,tsx}",
    "tests/style-snapshot/**/*.spec.ts",
    "vitest*.{ts,mts}",
    "playwright*.ts",
    "next.config.ts",
    "eslint.config.mjs",
    "src/proxy.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx,js,mjs}",
    "scripts/**/*.{ts,mjs}",
    "tests/**/*.{ts,tsx}",
    "*.{ts,mts,mjs}",
    "!src/payload-types.ts",
    "!src/payload-generated-schema.ts",
    "!src/generator/vendor/**",
    "!src/migrations/**",
    "!src/app/(payload)/admin/importMap.js",
    "src/migrations/index.ts"
  ],
  "ignore": [
    "src/payload-types.ts",
    "src/payload-generated-schema.ts",
    "src/generator/vendor/**",
    "src/app/(payload)/admin/importMap.js"
  ],
  "next": true,
  "vitest": {
    "config": ["vitest*.{ts,mts}"]
  },
  "playwright": {
    "config": ["playwright*.ts"]
  }
}
