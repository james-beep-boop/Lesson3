# Lesson3 — CANONICAL environment reference (Docker Compose / production).
#
# Copy to `.env` and fill in. Never commit the real `.env`.
# Compose passes this whole file to the `app`, `migrate` and `postgres` services (`env_file: .env`),
# so it must carry BOTH the app's configuration and Compose's own variables.
#
# There are two templates, for two different consumers:
#   - THIS FILE            → containers (Compose/production). The complete reference.
#   - `app/.env.example`   → a host-local `next dev` run. A small dev-shaped subset; see AGENTS.md.
# `app/tests/unit/envTemplateParity.spec.ts` mechanically enforces that this file declares every
# variable the app reads, that neither file declares anything it doesn't, and that each points
# DATABASE_URI at the host its own consumer needs. Read that test before restructuring either file.
#
# Ops variables for the BACKUP/PRUNE SCRIPTS (BACKUP_AGE_RECIPIENT, BACKUP_RCLONE_REMOTE, retention
# and HEALTHCHECK_* knobs) also live in `.env` on a deployed box, but they are read by `scripts/*.sh`
# and never by the app — so they are documented in `docs/OPS.md` rather than declared here.

# ───────────────────────────── Required ─────────────────────────────

# Long random string — generate with: openssl rand -hex 32
# Rotating it invalidates every existing session.
PAYLOAD_SECRET=

# Postgres password. MUST match the password inside DATABASE_URI below.
# Read by the `postgres` service in docker-compose.yml.
POSTGRES_PASSWORD=

# Payload connects to the Compose `postgres` service over the internal network, so the host is the
# service name `postgres` — not localhost. (Host-local dev uses app/.env.example instead.)
DATABASE_URI=postgres://lesson3:REPLACE_WITH_POSTGRES_PASSWORD@postgres:5432/lesson3

NODE_ENV=production
PORT=3000

# Base URL used to build links in outbound email (e.g. the password-reset link). No trailing slash.
# Note this is separate from SERVER_URL below: the reset-email base comes from HERE, so mail works
# without opting into strict CSRF.
ADMIN_URL=http://localhost:3001

# REQUIRED — where generated DOCX/PDF bytes are cached. In the Compose stack this is the mount path
# of the `lesson3_artifact_cache` named volume on the `app` service (durable across `up --build`).
#
# ⚑ Do not omit this. Unset, the cache falls back to `/app/.artifact-cache`, which the non-root
# container user cannot write — every export job then fails with EACCES and the client polls a `202`
# forever. A fresh install that skipped this line was broken on arrival; that is why the parity test
# above exists. (Dev outside Docker falls back to a local ./.artifact-cache, which is fine.)
ARTIFACT_CACHE_DIR=/var/cache/lesson3

# ───────────────────── Public-exposure posture ──────────────────────

# THE SINGLE PUBLIC-POSTURE SWITCH. Setting it enables, together: Payload's strict CSRF allowlist,
# Secure auth cookies (when https), and the empty-users boot refusal. It cannot be half-applied —
# see the "Going public" checklist in docs/OPS.md and work through that list in order.
#
# Leave it EMPTY (not unset — empty string, or Payload still pushes `undefined` to the allowlist) on
# internal / plain-HTTP hosts: strict CSRF bounces browsers that send neither Origin nor
# Sec-Fetch-Site on same-origin GETs (e.g. older Safari), which log in then loop back to the form.
# Cookie auth is still protected by the SameSite=Lax cookie in that posture.
SERVER_URL=

# ──────────────────── Public discovery (optional) ───────────────────

# Set to exactly `1` to serve the PUBLIC lesson library: the "Explore free lesson plans" action on
# /login, and the public /explore routes. Anything else — including `0`, `false`, or unset — means
# OFF, and every public route returns 404. Only `1` enables it, so a typo cannot publish a corpus.
#
# ⚑ OFFLINE SCHOOL INSTALLATIONS LEAVE THIS UNSET. They get the authenticated library with no
# public surface, no promotional UI and no internet dependency at all — that is the point of the
# switch existing separately from SERVER_URL, which owns SECURITY posture rather than product shape.
#
# ⚑ Setting this WITHOUT SERVER_URL REFUSES TO BOOT. Public pages build absolute URLs for social
# share cards and the printed document footer; without a base URL those degrade silently on exactly
# the pages meant to travel. See app/src/lib/publicLibrary.ts and docs/DESIGN-public-library.md.
PUBLIC_LIBRARY_ENABLED=

# ─────────────────────── DOCX → PDF sidecar ─────────────────────────

# Gotenberg (headless LibreOffice). In Compose this is the internal service host; override only if
# you run the converter elsewhere. PDF export (`?as=pdf`) fails fast if it is unreachable.
GOTENBERG_URL=http://gotenberg:3000
# Optional. Per-conversion request timeout (ms) — caps a hung conversion. Default 120000, matching
# the sidecar's own --api-timeout in docker-compose.yml.
GOTENBERG_TIMEOUT_MS=120000
# Optional. Max CONCURRENT synchronous conversions for the editor's unsaved "View as PDF"
# (POST /:id/preview-pdf), which runs Gotenberg inside the request. Excess requests get 503.
# In-process, per app instance. Default 2, matching the jobs-queue global cap.
PREVIEW_PDF_MAX_CONCURRENT=2

# ──────────────────────── Artifact cache ────────────────────────────
# (ARTIFACT_CACHE_DIR is required — see the Required section above.)

# Optional. Evicts oldest-by-mtime once the total cache size exceeds this. Default 512 MiB.
ARTIFACT_CACHE_MAX_BYTES=536870912

# ──────────────────────────── Email ─────────────────────────────────

# Optional. If SMTP_HOST is unset, mail falls back to the console and password resets are NOT
# delivered. Set all of these to enable real email.
# Gmail: host=smtp.gmail.com, port=465, user=<account>, pass=<16-char Google App Password>
# (App Passwords require 2-Step Verification; a normal Google login will NOT work.)
# Port 465 selects implicit TLS automatically; anything else (e.g. 587) uses STARTTLS.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=ARES Lesson Library
EMAIL_FROM_ADDRESS=

# ───────────────────────── Rate limits ──────────────────────────────
# All optional; defaults shown. Windows are FIXED windows in ms, counted in a shared Postgres table
# (lib/rateLimit.ts) — up to ~2x a budget can slip across one window boundary. Tune for your users.

# Generation endpoints. `export` is async via the jobs queue; `preview` is cheap (mammoth);
# `previewPdf` runs Gotenberg synchronously in the request, so it is the tightest of the three
# (concurrency is bounded separately by PREVIEW_PDF_MAX_CONCURRENT above).
RATE_LIMIT_EXPORT_MAX=20
RATE_LIMIT_EXPORT_WINDOW_MS=60000
RATE_LIMIT_PREVIEW_MAX=40
RATE_LIMIT_PREVIEW_WINDOW_MS=60000
# Edit-recovery capture budget. Sized for several tabs on one plan, each capturing on an
# ~8s debounce plus blur and pre-expiry flushes. Too tight means unsaved work is not backed up.
RATE_LIMIT_RECOVERY_MAX=120
RATE_LIMIT_RECOVERY_WINDOW_MS=60000
RATE_LIMIT_PREVIEW_PDF_MAX=10
RATE_LIMIT_PREVIEW_PDF_WINDOW_MS=60000
# Bundle upload — a runaway guard, not an abuse gate (the endpoint is Site-Administrator only). Sized
# to be unreachable by real use: a batch is a few dozen plans, i.e. one or two requests of up to 50
# files each. Raise it rather than work around it if a legitimate import ever trips it.
RATE_LIMIT_UPLOAD_MAX=50
RATE_LIMIT_UPLOAD_WINDOW_MS=900000

# Email-a-doc (SPEC §10) — DAILY caps, because the bounded cost is other people's inboxes and our
# SMTP reputation, not CPU. Per user, then per recipient address (shared across senders), then a
# site-wide ceiling.
RATE_LIMIT_EMAIL_MAX=10
RATE_LIMIT_EMAIL_WINDOW_MS=86400000
RATE_LIMIT_EMAIL_RECIPIENT_MAX=20
RATE_LIMIT_EMAIL_RECIPIENT_WINDOW_MS=86400000
RATE_LIMIT_EMAIL_GLOBAL_MAX=1000
RATE_LIMIT_EMAIL_GLOBAL_WINDOW_MS=86400000

# Internal messaging (SPEC §10): per-user daily cap on message creation, plus a per-recipient daily
# cap on the content-free notification-ping emails (exhaustion skips the ping, never the message).
RATE_LIMIT_MESSAGE_MAX=50
RATE_LIMIT_MESSAGE_WINDOW_MS=86400000
RATE_LIMIT_MESSAGE_PING_RECIPIENT_MAX=20
RATE_LIMIT_MESSAGE_PING_RECIPIENT_WINDOW_MS=86400000

# Auth operations (SPEC §11). Login is keyed by the TARGET email, which bounds distributed guessing
# and the lockout-DoS blast radius; Payload's own maxLoginAttempts lockout guards single-account
# brute force. Signup and forgot-password use the same two-tier shape (per identifier + site-wide).
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_LOGIN_WINDOW_MS=3600000
RATE_LIMIT_LOGIN_GLOBAL_MAX=1000
RATE_LIMIT_LOGIN_GLOBAL_WINDOW_MS=3600000
RATE_LIMIT_SIGNUP_MAX=3
RATE_LIMIT_SIGNUP_WINDOW_MS=86400000
RATE_LIMIT_SIGNUP_GLOBAL_MAX=100
RATE_LIMIT_SIGNUP_GLOBAL_WINDOW_MS=86400000
RATE_LIMIT_FORGOT_PASSWORD_MAX=5
RATE_LIMIT_FORGOT_PASSWORD_WINDOW_MS=86400000
RATE_LIMIT_FORGOT_PASSWORD_GLOBAL_MAX=100
RATE_LIMIT_FORGOT_PASSWORD_GLOBAL_WINDOW_MS=86400000
# A Site Administrator revealing a reset link for hand-delivery. Its OWN budget, deliberately not the
# two forgot-password ones above: in a deployment with no reliable email this is the ONLY
# account-recovery path, so exhausting the public daily budget must not also disable the fallback.
# Still capped — authenticated, Site-Admin-only, keyed per administrator, sends no mail.
RATE_LIMIT_ADMIN_RESET_LINK_MAX=30
RATE_LIMIT_ADMIN_RESET_LINK_WINDOW_MS=3600000
# Email-verification attempts are token-only and public, so there is no per-target key to bound —
# a site-global daily ceiling is the honest app-level limit until edge rate limiting lands.
RATE_LIMIT_VERIFY_EMAIL_GLOBAL_MAX=300
RATE_LIMIT_VERIFY_EMAIL_GLOBAL_WINDOW_MS=86400000

# "Request editing access" — one request per user per subject-grade per day (asking about Biology G10
# does not block asking about Chemistry G11). Bounds admin-inbox noise.
RATE_LIMIT_EDIT_REQUEST_MAX=1
RATE_LIMIT_EDIT_REQUEST_WINDOW_MS=86400000

# Minimum response time (ms) for forgot-password, so a real vs unknown address cannot be
# distinguished by timing. Raise only if your SMTP path is slower than this floor.
FORGOT_PASSWORD_RESPONSE_FLOOR_MS=400

# ───────────────────── Jobs queue / logging / ops ───────────────────

# Optional. Payload jobs autorun: 6-field cron (leading seconds) and the per-tick concurrency cap.
# The default polls every 3s and runs at most 2 jobs at once.
JOBS_AUTORUN_CRON=*/3 * * * * *
JOBS_AUTORUN_LIMIT=2

# Optional. Payload's logger is pino → JSON. Default 'info'. In the container the stream is bounded
# and rotated by Docker's json-file driver (docker-compose.yml).
LOG_LEVEL=info

# Optional error tracking (self-hosted GlitchTip is the standing choice — docs/OPS.md). With
# SENTRY_DSN unset, every error-tracking call is a no-op. SENTRY_ENVIRONMENT defaults to 'production'.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
