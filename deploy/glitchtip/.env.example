# GlitchTip (error tracking) — copy to `.env` beside compose.yaml and fill in. Never commit `.env`.
#
# This is a SEPARATE file from the app's own `.env`. The two stacks share nothing but the Docker
# daemon, and the app's `.env` is validated by app/tests/unit/envTemplateParity.spec.ts, which knows
# about exactly two templates — this one is deliberately outside its scope.

# Any long random string. Rotating it invalidates existing GlitchTip sessions.
#   openssl rand -hex 32
SECRET_KEY=

# Postgres password for the glitchtip database. Must match the one inside DATABASE_URL below.
#   openssl rand -hex 32
GLITCHTIP_POSTGRES_PASSWORD=

# Written out in full — one place a password appears, so the two cannot drift. Host is the compose
# service name `postgres`, reached over this stack's internal network.
DATABASE_URL=postgres://glitchtip:REPLACE_WITH_GLITCHTIP_POSTGRES_PASSWORD@postgres:5432/glitchtip

# The URL GlitchTip believes it is served at, INCLUDING the scheme. It goes into the links in the
# emails it sends, so a wrong value here produces mail nobody can follow — the same failure the app's
# own ADMIN_URL guard exists to prevent (deploy/online/install.sh).
#
# With the loopback binding in compose.yaml and an SSH tunnel, this is what your browser shows:
GLITCHTIP_DOMAIN=http://localhost:9000

# Optional. Outbound mail, for invitations and alert notifications. Unset, GlitchTip still records
# events and shows them in the UI — you simply are not told about them, which rather defeats the
# point, so set this before relying on it for alerting.
# The Rock's app stack already has working SMTP credentials in its own .env; reuse the same account.
#   Format: smtp://USER:PASSWORD@HOST:PORT   (URL-encode any @ or / in the password)
EMAIL_URL=
DEFAULT_FROM_EMAIL=
